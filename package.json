{
  "name": "cozypdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A beautiful, free, local-first PDF reading PWA with reflowable Book Mode and Listen Mode.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.js 8787\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js 8787",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.19.2",
    "idb": "^8.0.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
