COZYPDFS_DATABASE_URL=sqlite:///./data/cozypdfs.db
COZYPDFS_STORAGE_BACKEND=local
COZYPDFS_STORAGE_LOCAL_ROOT=./data/storage
COZYPDFS_STORAGE_LOCAL_BASE_URL=/storage
COZYPDFS_COOKIE_SECRET=change-me-in-production
COZYPDFS_MAX_UPLOAD_SIZE_MB=100
COZYPDFS_MAX_PAGE_COUNT=2000
COZYPDFS_RETAIN_ORIGINAL_PDFS=true
COZYPDFS_JOB_POLL_INTERVAL=1.0
COZYPDFS_JOB_CONCURRENCY=1
COZYPDFS_JOB_TIMEOUT_SECONDS=300.0
COZYPDFS_CORS_ORIGINS=["http://localhost:5173"]
